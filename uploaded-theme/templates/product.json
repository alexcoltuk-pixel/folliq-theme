    "problem_solution_folliq_1": {
      "type": "problem-solution-folliq",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "icon": "warning",
            "title": "The Lie: Any Shampoo Will Fix It",
            "text_1": "You've tried every shampoo on the shelf. Hair feels fine for a week, then the shedding returns.",
            "text_2": "Most formulas were never designed to strengthen hair at the root."
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "icon": "search",
            "title": "The Truth: Weak Roots Need More Than Cleansing",
            "text_1": "Stress, buildup, and harsh sulfates weaken the follicle over time, making hair thinner with every wash.",
            "text_2": "Regular shampoo cleans the surface. The root stays undernourished."
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "icon": "lightbulb",
            "title": "The Solution: Nourish First, Then Cleanse",
            "text_1": "Folliq combines rosemary, ginger, and biotin to nourish the scalp first, then gently cleanse without stripping.",
            "text_2": "Not harsher. In the right order."
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ],
      "settings": {
        "heading": "Thinning Hair Will NEVER Improve",
        "heading_accent": "Unless You Do This",
        "subheading": "<p>The real problem starts at the follicle, where most shampoos never reach.</p>",
        "color_scheme": "scheme-3"
      }
    },
