{% doc %}
  @prompt
    Create a premium testimonial section for the Folliq hair care brand.
    
    Brand Style:
    - Minimal
    - Luxury
    - Botanical
    - Clinical
    - Scandinavian
    - Premium skincare aesthetic
    - Inspired by Apple, Aesop, Vegamour and Rhode.
    
    Color Palette:
    - Primary Green: #33452D
    - Dark Green: #273522
    - Accent Green: #56694B
    - Background: #F2EEE3
    - Secondary Background: #FAF8F3
    - White: #FFFFFF
    
    Typography:
    - Heading: Elegant serif (Cormorant Garamond style)
    - Body: Modern sans-serif (Manrope or Inter style)
    
    Section Layout:
    
    Center all content.
    
    Small label above heading:
    ★★★★★ 4.9/5 CUSTOMER RATING
    
    Main Heading:
    Trusted by Thousands
    
    Subheading:
    Join thousands of customers who have transformed their hair with Folliq. Read real experiences from people who chose healthier, stronger-looking hair.
    
    Below the heading create a responsive testimonial carousel.
    
    Desktop:
    3 testimonial cards visible.
    
    Tablet:
    2 cards.
    
    Mobile:
    1 card.
    
    Each testimonial card should include:
    
    • Customer profile image (circle)
    • Customer name
    • Verified Buyer badge
    • Five green stars
    • Short review (2–4 lines)
    • Optional "Used for 3 months" label
    • Small country flag in the corner
    
    Cards should have:
    - White background
    - 20px border radius
    - Soft shadow
    - Plenty of whitespace
    - Premium spacing
    
    Hover effect:
    - Lift card by 4px
    - Slight shadow increase
    - Smooth 300ms animation
    
    Section background:
    Warm Ivory (#F2EEE3)
    
    Spacing:
    120px top
    120px bottom
    
    Maximum content width:
    1280px
    
    Include left/right carousel arrows and pagination dots.
    
    Everything should feel elegant, premium, trustworthy and clean.
    
    The section should be fully editable inside the Shopify Theme Editor, allowing changes to:
    - Heading
    - Subheading
    - Reviews
    - Customer names
    - Photos
    - Rating
    - Country
    - Review text
    - Colors
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .folliq-testimonials-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .folliq-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .folliq-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .folliq-testimonials-rating-label-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: {{ block.settings.label_color }};
    margin-bottom: 16px;
  }

  .folliq-testimonials-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: 14px;
  }

  .folliq-testimonials-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    font-weight: 400;
  }

  .folliq-testimonials-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.6;
    color: {{ block.settings.subheading_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  .folliq-testimonials-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    padding: 0 60px;
  }

  .folliq-testimonials-carousel-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    transition: transform 0.5s ease;
  }

  .folliq-testimonials-card-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 16px);
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .folliq-testimonials-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .folliq-testimonials-card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .folliq-testimonials-avatar-{{ ai_gen_id }} {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: {{ block.settings.section_background }};
  }

  .folliq-testimonials-avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .folliq-testimonials-avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.accent_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.card_background }};
    font-size: 24px;
    font-weight: 600;
  }

  .folliq-testimonials-customer-info-{{ ai_gen_id }} {
    flex: 1;
  }

  .folliq-testimonials-customer-name-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.heading_color }};
    margin: 0 0 4px;
  }

  .folliq-testimonials-verified-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: {{ block.settings.accent_color }};
    font-weight: 500;
  }

  .folliq-testimonials-verified-icon-{{ ai_gen_id }} {
    width: 14px;
    height: 14px;
  }

  .folliq-testimonials-card-stars-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: 16px;
    margin-bottom: 16px;
  }

  .folliq-testimonials-review-text-{{ ai_gen_id }} {
    font-size: 15px;
    line-height: 1.7;
    color: {{ block.settings.text_color }};
    margin-bottom: 16px;
  }

  .folliq-testimonials-card-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .folliq-testimonials-usage-label-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.subheading_color }};
    font-style: italic;
  }

  .folliq-testimonials-country-flag-{{ ai_gen_id }} {
    font-size: 20px;
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.card_background }};
    border: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.heading_color }};
    border-color: {{ block.settings.heading_color }};
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }}:hover svg {
    stroke: {{ block.settings.card_background }};
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.heading_color }};
    transition: stroke 0.3s ease;
  }

  .folliq-testimonials-arrow-left-{{ ai_gen_id }} {
    left: 0;
  }

  .folliq-testimonials-arrow-right-{{ ai_gen_id }} {
    right: 0;
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }}:disabled:hover {
    background-color: {{ block.settings.card_background }};
    border-color: rgba(0, 0, 0, 0.1);
  }

  .folliq-testimonials-arrow-{{ ai_gen_id }}:disabled:hover svg {
    stroke: {{ block.settings.heading_color }};
  }

  .folliq-testimonials-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 40px;
  }

  .folliq-testimonials-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .folliq-testimonials-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.accent_color }};
    width: 24px;
    border-radius: 4px;
  }

  @media screen and (max-width: 989px) {
    .folliq-testimonials-card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 12px);
    }

    .folliq-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .folliq-testimonials-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 50px;
    }
  }

  @media screen and (max-width: 749px) {
    .folliq-testimonials-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 16px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .folliq-testimonials-header-{{ ai_gen_id }} {
      margin-bottom: 40px;
    }

    .folliq-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.65 }}px;
    }

    .folliq-testimonials-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }

    .folliq-testimonials-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
      padding: 24px;
    }

    .folliq-testimonials-carousel-wrapper-{{ ai_gen_id }} {
      padding: 0 40px;
    }

    .folliq-testimonials-arrow-{{ ai_gen_id }} {
      width: 36px;
      height: 36px;
    }

    .folliq-testimonials-arrow-{{ ai_gen_id }} svg {
      width: 16px;
      height: 16px;
    }
  }
{% endstyle %}

<folliq-testimonials-{{ ai_gen_id }} class="folliq-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="folliq-testimonials-container-{{ ai_gen_id }}">
    <div class="folliq-testimonials-header-{{ ai_gen_id }}">
      {% if block.settings.show_rating_label %}
        <div class="folliq-testimonials-rating-label-{{ ai_gen_id }}">
          <span class="folliq-testimonials-stars-{{ ai_gen_id }}">★★★★★</span>
          <span>{{ block.settings.rating_label }}</span>
        </div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h2 class="folliq-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      
      {% if block.settings.subheading != blank %}
        <div class="folliq-testimonials-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
    </div>

    <div class="folliq-testimonials-carousel-wrapper-{{ ai_gen_id }}">
      <button 
        class="folliq-testimonials-arrow-{{ ai_gen_id }} folliq-testimonials-arrow-left-{{ ai_gen_id }}"
        aria-label="Previous testimonials"
        data-direction="prev"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 18L9 12L15 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="folliq-testimonials-carousel-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign testimonial_enabled_key = 'testimonial_' | append: i | append: '_enabled'
            assign customer_name_key = 'testimonial_' | append: i | append: '_name'
            assign customer_image_key = 'testimonial_' | append: i | append: '_image'
            assign review_text_key = 'testimonial_' | append: i | append: '_review'
            assign usage_duration_key = 'testimonial_' | append: i | append: '_usage'
            assign country_flag_key = 'testimonial_' | append: i | append: '_country'

            assign testimonial_enabled = block.settings[testimonial_enabled_key]
            assign customer_name = block.settings[customer_name_key]
            assign customer_image = block.settings[customer_image_key]
            assign review_text = block.settings[review_text_key]
            assign usage_duration = block.settings[usage_duration_key]
            assign country_flag = block.settings[country_flag_key]
          %}

          {% if testimonial_enabled %}
            <div class="folliq-testimonials-card-{{ ai_gen_id }}">
              <div class="folliq-testimonials-card-header-{{ ai_gen_id }}">
                <div class="folliq-testimonials-avatar-{{ ai_gen_id }}">
                  {% if customer_image %}
                    <img 
                      src="{{ customer_image | image_url: width: 112 }}" 
                      alt="{{ customer_name | escape }}"
                      width="56"
                      height="56"
                      loading="lazy"
                    >
                  {% else %}
                    <div class="folliq-testimonials-avatar-placeholder-{{ ai_gen_id }}">
                      {{ customer_name | slice: 0 | upcase }}
                    </div>
                  {% endif %}
                </div>
                <div class="folliq-testimonials-customer-info-{{ ai_gen_id }}">
                  <div class="folliq-testimonials-customer-name-{{ ai_gen_id }}">{{ customer_name }}</div>
                  <div class="folliq-testimonials-verified-badge-{{ ai_gen_id }}">
                    <svg class="folliq-testimonials-verified-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Verified Buyer
                  </div>
                </div>
              </div>

              <div class="folliq-testimonials-card-stars-{{ ai_gen_id }}">★★★★★</div>

              <div class="folliq-testimonials-review-text-{{ ai_gen_id }}">{{ review_text }}</div>

              <div class="folliq-testimonials-card-footer-{{ ai_gen_id }}">
                {% if usage_duration != blank %}
                  <div class="folliq-testimonials-usage-label-{{ ai_gen_id }}">{{ usage_duration }}</div>
                {% else %}
                  <div></div>
                {% endif %}
                {% if country_flag != blank %}
                  <div class="folliq-testimonials-country-flag-{{ ai_gen_id }}">{{ country_flag }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button 
        class="folliq-testimonials-arrow-{{ ai_gen_id }} folliq-testimonials-arrow-right-{{ ai_gen_id }}"
        aria-label="Next testimonials"
        data-direction="next"
      >
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 18L15 12L9 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="folliq-testimonials-pagination-{{ ai_gen_id }}"></div>
  </div>
</folliq-testimonials-{{ ai_gen_id }}>

<script>
  (function() {
    class FolliqTestimonials{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.carousel = this.querySelector('.folliq-testimonials-carousel-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.folliq-testimonials-card-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.folliq-testimonials-arrow-left-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.folliq-testimonials-arrow-right-{{ ai_gen_id }}');
        this.pagination = this.querySelector('.folliq-testimonials-pagination-{{ ai_gen_id }}');
        this.cardsPerView = 3;
      }

      connectedCallback() {
        this.updateCardsPerView();
        this.createPagination();
        this.updateCarousel();
        this.setupEventListeners();
        
        window.addEventListener('resize', () => {
          this.updateCardsPerView();
          this.createPagination();
          this.updateCarousel();
        });
      }

      updateCardsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.cardsPerView = 1;
        } else if (width <= 989) {
          this.cardsPerView = 2;
        } else {
          this.cardsPerView = 3;
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.navigate('prev'));
        this.nextButton.addEventListener('click', () => this.navigate('next'));
      }

      navigate(direction) {
        const totalCards = this.cards.length;
        const maxIndex = Math.max(0, totalCards - this.cardsPerView);

        if (direction === 'prev') {
          this.currentIndex = Math.max(0, this.currentIndex - 1);
        } else {
          this.currentIndex = Math.min(maxIndex, this.currentIndex + 1);
        }

        this.updateCarousel();
      }

      updateCarousel() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = 24;
        const offset = -(this.currentIndex * (cardWidth + gap));
        
        this.carousel.style.transform = `translateX(${offset}px)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.cards.length - this.cardsPerView;

        this.updatePagination();
      }

      createPagination() {
        this.pagination.innerHTML = '';
        const totalDots = Math.max(1, this.cards.length - this.cardsPerView + 1);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.classList.add('folliq-testimonials-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            this.currentIndex = i;
            this.updateCarousel();
          });
          this.pagination.appendChild(dot);
        }
      }

      updatePagination() {
        const dots = this.pagination.querySelectorAll('.folliq-testimonials-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }
    }

    customElements.define('folliq-testimonials-{{ ai_gen_id }}', FolliqTestimonials{{ ai_gen_id }});
  })();
</script>

