{% doc %}
  @prompt
    Create an ultra-premium Shopify Hero Section for the luxury natural shampoo brand "Folliq".
    
    Aspect Ratio: 9:16 (1080×1920)
    
    STYLE
    Minimal luxury, Scandinavian wellness meets Aesop + Rituals + Apple product photography.
    Photorealistic, commercial advertising quality, cinematic lighting, 8K.
    
    BACKGROUND
    
    A breathtaking tropical rainforest with a massive multi-level waterfall flowing into crystal-clear emerald water.
    Golden morning sunlight filtering through jungle leaves.
    Soft mist, natural volumetric light, realistic reflections, lush green plants, wet rocks and subtle water splashes.
    The environment should feel fresh, luxurious and premium—not wild or messy.
    
    COMPOSITION
    
    Leave approximately 40% empty space in the upper-left area for website headline and CTA.
    
    The product sits on a wet dark volcanic rock in the lower-right third.
    
    The waterfall occupies the center background.
    
    Depth of field creates strong separation between foreground and background.
    
    The image should immediately communicate:
    Nature.
    Luxury.
    Clean Beauty.
    Premium Hair Care.
    
    PRODUCT
    
    Folliq Shampoo Bar with premium emerald-green packaging.
    Dark green luxury box with elegant gold logo.
    Soap slightly in front of the box.
    Natural water droplets on the packaging.
    Perfect reflections.
    Extremely sharp product.
    
    TEXT AREA
    
    Keep the upper-left area clean with soft background blur.
    
    No objects crossing behind the text.
    
    Leave enough negative space for:
    
    Headline
    Subheadline
    CTA button
    
    OVERLAY
    
    Very soft dark gradient from left to right (15–20% opacity) to improve text readability.
    
    COLORS
    
    Emerald Green
    Forest Green
    Gold
    Deep Black
    Warm White
    
    LIGHTING
    
    Golden hour.
    Soft cinematic sunlight.
    Luxury skincare commercial lighting.
    Natural reflections.
    Premium shadows.
    
    CAMERA
    
    85mm lens
    f/2.8
    HDR
    Ultra realistic
    Commercial photography
    Award-winning advertising
    Apple keynote quality
    Luxury skincare campaign
    
    NEGATIVE PROMPT
    
    No people
    No hands
    No excessive leaves blocking the product
    No fake CGI look
    No text
    No logos outside the packaging
    No watermark
    No low resolution
    No oversaturated colors
    No clutter
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-folliq-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .ai-folliq-hero__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-folliq-hero__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ai-folliq-hero__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a3a2e 0%, #2d5a4a 50%, #1a3a2e 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-folliq-hero__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 400px;
    max-height: 400px;
    opacity: 0.3;
  }

  .ai-folliq-hero__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    padding: 16px 32px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
    pointer-events: none;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    backdrop-filter: blur(10px);
  }

  .ai-folliq-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | times: 0.5 }}) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  .ai-folliq-hero__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    padding: {{ block.settings.content_padding_mobile }}px;
    z-index: 2;
  }

  .ai-folliq-hero__content-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    width: 100%;
  }

  .ai-folliq-hero__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.1;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_text_transform }};
  }

  .ai-folliq-hero__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size_mobile }}px;
    line-height: 1.5;
    font-weight: {{ block.settings.subheading_weight }};
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    opacity: {{ block.settings.subheading_opacity }};
  }

  .ai-folliq-hero__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-folliq-hero__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_bg_hover_color }};
    color: {{ block.settings.button_text_hover_color }};
    border-color: {{ block.settings.button_border_hover_color }};
    transform: translateY(-2px);
  }

  @media screen and (min-width: 750px) {
    .ai-folliq-hero__content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding_desktop }}px;
    }

    .ai-folliq-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-folliq-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }
  }
{% endstyle %}

<folliq-hero-{{ ai_gen_id }} class="ai-folliq-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-folliq-hero__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        srcset="
          {{ block.settings.hero_image | image_url: width: 750 }} 750w,
          {{ block.settings.hero_image | image_url: width: 1080 }} 1080w,
          {{ block.settings.hero_image | image_url: width: 1500 }} 1500w,
          {{ block.settings.hero_image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-folliq-hero__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-folliq-hero__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-folliq-hero__empty-state-{{ ai_gen_id }}">
          Add your luxury hero image (9:16 aspect ratio recommended)
        </div>
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-folliq-hero__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-folliq-hero__content-{{ ai_gen_id }}">
    <div class="ai-folliq-hero__content-inner-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-folliq-hero__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-folliq-hero__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-folliq-hero__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</folliq-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class FolliqHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupLazyLoading();
      }

      setupLazyLoading() {
        const image = this.querySelector('.ai-folliq-hero__image-{{ ai_gen_id }}');
        if (image && 'loading' in HTMLImageElement.prototype) {
          image.loading = 'eager';
        }
      }
    }

    customElements.define('folliq-hero-{{ ai_gen_id }}', FolliqHero{{ ai_gen_id }});
  })();
</script>

