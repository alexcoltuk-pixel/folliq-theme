{% doc %}
  @prompt
    Create a premium "Key Ingredients" section for the Folliq hair care brand.
    
    IMPORTANT:
    Follow the official Folliq Brand Guidelines exactly.
    
    Brand Style:
    
    • Premium
    • Luxury
    • Minimal
    • Botanical
    • Clinical
    • Scandinavian
    • Clean
    • Elegant
    
    Inspired by:
    Apple, Aesop, Act+Acre, Vegamour, Rhode and Ritual.
    
    Use ONLY the official Folliq brand colors.
    
    COLOR PALETTE
    
    Primary Green
    #33452D
    
    Dark Green
    #273522
    
    Accent Green
    #56694B
    
    Warm Ivory
    #F2EEE3
    
    Soft Ivory
    #FAF8F3
    
    Text
    #1F231D
    
    Border
    #D9D8D2
    
    Never introduce additional colors.
    
    ----------------------------------------------------
    
    SECTION BACKGROUND
    
    Background:
    #FAF8F3
    
    Maximum Width:
    1480px
    
    Top Padding:
    120px
    
    Bottom Padding:
    120px
    
    ----------------------------------------------------
    
    SECTION HEADER
    
    Small Label
    
    BOTANICAL SCIENCE
    
    Heading
    
    Powered by Nature.
    Backed by Science.
    
    Description
    
    Every Folliq bar is carefully formulated with botanical extracts selected to nourish the scalp, strengthen hair, and support healthier-looking growth.
    
    Center aligned.
    
    ----------------------------------------------------
    
    INGREDIENT GRID
    
    Create a responsive grid.
    
    Desktop:
    3 columns
    
    Tablet:
    2 columns
    
    Mobile:
    1 column
    
    Each ingredient should be displayed inside an individual premium card.
    
    ----------------------------------------------------
    
    CARD DESIGN
    
    Background:
    #FFFFFF
    
    Border:
    1px solid #D9D8D2
    
    Border Radius:
    24px
    
    Padding:
    36px
    
    Soft Shadow
    
    Display a large botanical ingredient image at the top.
    
    The image should occupy approximately 60% of the card height.
    
    Use premium realistic botanical photography with transparent backgrounds.
    
    No illustrations.
    
    No flat icons.
    
    ----------------------------------------------------
    
    Each card should include:
    
    Ingredient Image
    
    Ingredient Name
    
    Short scientific description
    
    Optional Benefit Badge
    
    Example:
    
    Rosemary Extract
    
    Supports a healthier scalp and helps maintain stronger-looking hair.
    
    Badge:
    
    Scalp Support
    
    ----------------------------------------------------
    
    Suggested Ingredients
    
    Rosemary Extract
    
    Biotin
    
    Castor Oil
    
    Olive Fruit Oil
    
    Ginger Root Extract
    
    Polygonum Multiflorum Root
    
    ----------------------------------------------------
    
    TYPOGRAPHY
    
    Heading
    
    Cormorant Garamond
    
    56px Desktop
    
    36px Mobile
    
    Body
    
    Manrope
    
    18px
    
    Ingredient Title
    
    Cormorant Garamond
    
    28px
    
    Card Description
    
    Manrope
    
    16px
    
    ----------------------------------------------------
    
    HOVER EFFECT
    
    Card lifts 6px
    
    Shadow becomes slightly stronger
    
    Image scales to 103%
    
    Transition
    
    300ms ease
    
    ----------------------------------------------------
    
    ANIMATIONS
    
    Fade Up on scroll
    
    Cards appear with staggered animation
    
    ----------------------------------------------------
    
    THEME EDITOR SETTINGS
    
    Everything must be editable.
    
    Section Heading
    
    Section Description
    
    Ingredient Cards
    
    Ingredient Image
    
    Ingredient Name
    
    Ingredient Description
    
    Badge
    
    Button
    
    Spacing
    
    Colors
    
    Border Radius
    
    Card Order
    
    ----------------------------------------------------
    
    The final design should feel like a premium luxury wellness brand with generous whitespace, elegant typography, large botanical imagery, and a refined Scandinavian aesthetic consistent with the Folliq brand identity.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ingredients-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 80px;
  }

  .ai-ingredients-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin-bottom: 20px;
  }

  .ai-ingredients-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    margin: 0 0 24px;
  }

  .ai-ingredients-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    max-width: 680px;
    margin: 0 auto;
  }

  .ai-ingredients-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 32px;
  }

  .ai-ingredients-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 300ms ease, box-shadow 300ms ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }

  .ai-ingredients-card-{{ ai_gen_id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-ingredients-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 280px;
    margin-bottom: 28px;
    overflow: hidden;
    border-radius: 12px;
  }

  .ai-ingredients-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .ai-ingredients-card-{{ ai_gen_id }}:hover .ai-ingredients-card-image-{{ ai_gen_id }} {
    transform: scale(1.03);
  }

  .ai-ingredients-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #F2EEE3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredients-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-ingredients-card-content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-ingredients-card-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.card_title_size }}px;
    line-height: 1.3;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
  }

  .ai-ingredients-card-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.card_description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .ai-ingredients-card-badge-{{ ai_gen_id }} {
    display: inline-block;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: {{ block.settings.badge_text_color }};
    background-color: {{ block.settings.badge_background }};
    padding: 6px 14px;
    border-radius: 20px;
    align-self: flex-start;
  }

  @media screen and (max-width: 989px) {
    .ai-ingredients-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 0 {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-ingredients-header-{{ ai_gen_id }} {
      margin-bottom: 60px;
    }

    .ai-ingredients-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-ingredients-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: 24px;
    }

    .ai-ingredients-card-image-wrapper-{{ ai_gen_id }} {
      height: 240px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-ingredients-card-{{ ai_gen_id }} {
      padding: 28px;
    }

    .ai-ingredients-card-image-wrapper-{{ ai_gen_id }} {
      height: 220px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-ingredients-card-{{ ai_gen_id }},
    .ai-ingredients-card-image-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<folliq-ingredients-{{ ai_gen_id }} class="ai-ingredients-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-ingredients-header-{{ ai_gen_id }}">
        {% if block.settings.label != blank %}
          <div class="ai-ingredients-label-{{ ai_gen_id }}">
            {{ block.settings.label }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-ingredients-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-ingredients-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-ingredients-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign ingredient_enabled_key = 'ingredient_' | append: i | append: '_enabled'
          assign ingredient_image_key = 'ingredient_' | append: i | append: '_image'
          assign ingredient_name_key = 'ingredient_' | append: i | append: '_name'
          assign ingredient_description_key = 'ingredient_' | append: i | append: '_description'
          assign ingredient_badge_key = 'ingredient_' | append: i | append: '_badge'

          assign ingredient_enabled = block.settings[ingredient_enabled_key]
          assign ingredient_image = block.settings[ingredient_image_key]
          assign ingredient_name = block.settings[ingredient_name_key]
          assign ingredient_description = block.settings[ingredient_description_key]
          assign ingredient_badge = block.settings[ingredient_badge_key]
        %}

        {% if ingredient_enabled %}
          <div class="ai-ingredients-card-{{ ai_gen_id }}">
            <div class="ai-ingredients-card-image-wrapper-{{ ai_gen_id }}">
              {% if ingredient_image %}
                <img
                  src="{{ ingredient_image | image_url: width: 600 }}"
                  alt="{{ ingredient_name | escape }}"
                  loading="lazy"
                  width="600"
                  height="600"
                  class="ai-ingredients-card-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-ingredients-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-ingredients-card-content-{{ ai_gen_id }}">
              {% if ingredient_name != blank %}
                <h3 class="ai-ingredients-card-title-{{ ai_gen_id }}">
                  {{ ingredient_name }}
                </h3>
              {% endif %}

              {% if ingredient_description != blank %}
                <div class="ai-ingredients-card-description-{{ ai_gen_id }}">
                  {{ ingredient_description }}
                </div>
              {% endif %}

              {% if ingredient_badge != blank %}
                <span class="ai-ingredients-card-badge-{{ ai_gen_id }}">
                  {{ ingredient_badge }}
                </span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</folliq-ingredients-{{ ai_gen_id }}>

<script>
  (function() {
    class FolliqIngredients{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.observeCards();
      }

      observeCards() {
        if (!window.IntersectionObserver) return;

        const cards = this.querySelectorAll('.ai-ingredients-card-{{ ai_gen_id }}');
        
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
              }, index * 100);
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        cards.forEach((card) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(30px)';
          card.style.transition = 'opacity 600ms ease, transform 600ms ease';
          observer.observe(card);
        });
      }
    }

    customElements.define('folliq-ingredients-{{ ai_gen_id }}', FolliqIngredients{{ ai_gen_id }});
  })();
</script>

