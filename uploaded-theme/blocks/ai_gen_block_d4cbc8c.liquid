{% doc %}
  @prompt
    Create a premium "Customer Reviews" section for the Folliq hair care brand.
    
    IMPORTANT:
    Follow the official Folliq Brand Guidelines exactly.
    
    Brand Style:
    
    • Premium
    • Luxury
    • Minimal
    • Botanical
    • Clinical
    • Scandinavian
    • Elegant
    
    Inspired by:
    
    Apple
    Aesop
    Act+Acre
    Vegamour
    Rhode
    
    Use ONLY the official Folliq brand colors.
    
    --------------------------------------------------
    
    COLOR PALETTE
    
    Primary Green
    #33452D
    
    Dark Green
    #273522
    
    Accent Green
    #56694B
    
    Warm Ivory
    #F2EEE3
    
    Soft Ivory
    #FAF8F3
    
    Text
    #1F231D
    
    Border
    #D9D8D2
    
    Never introduce any additional colors.
    
    --------------------------------------------------
    
    SECTION BACKGROUND
    
    Background
    
    #FAF8F3
    
    Maximum Width
    
    1480px
    
    Padding
    
    120px Top
    
    120px Bottom
    
    --------------------------------------------------
    
    SECTION HEADER
    
    Small Label
    
    REAL CUSTOMER STORIES
    
    Heading
    
    Loved by Thousands of Customers
    
    Description
    
    Discover authentic experiences from customers who made Folliq part of their hair care routine.
    
    Center aligned.
    
    --------------------------------------------------
    
    TOP AREA
    
    Create a premium horizontal carousel containing UGC video testimonials.
    
    Desktop
    
    4 Videos
    
    Tablet
    
    2 Videos
    
    Mobile
    
    1 Video
    
    Each video card should include:
    
    Vertical video thumbnail
    
    Rounded corners
    
    24px
    
    Large play button
    
    Customer first name
    
    Country flag
    
    ★★★★★
    
    Duration
    
    Example
    
    0:28
    
    Hover
    
    Slight zoom
    
    Soft shadow
    
    Fade animation
    
    --------------------------------------------------
    
    VIDEO CARD STYLE
    
    Background
    
    White
    
    Border Radius
    
    24px
    
    Border
    
    1px solid #D9D8D2
    
    Soft shadow
    
    Premium spacing
    
    --------------------------------------------------
    
    BELOW VIDEO CAROUSEL
    
    Display a second carousel with written customer reviews.
    
    Desktop
    
    3 Cards
    
    Tablet
    
    2 Cards
    
    Mobile
    
    1 Card
    
    Each review includes
    
    Customer Photo
    
    Customer Name
    
    Verified Buyer Badge
    
    ★★★★★
    
    Short Review
    
    Product Purchased
    
    Country Flag
    
    Optional "Used for 3 Months" badge
    
    White Card
    
    Rounded 24px
    
    Soft shadow
    
    Hover lift
    
    --------------------------------------------------
    
    SUMMARY BAR
    
    Above the review cards display:
    
    ★★★★★ 4.9/5
    
    Based on 10,000+ Verified Reviews
    
    Trusted by customers worldwide.
    
    Centered.
    
    --------------------------------------------------
    
    OPTIONAL TRUST METRICS
    
    Display four small statistic cards.
    
    ★★★★★
    
    4.9 Average Rating
    
    10K+
    
    Happy Customers
    
    95%
    
    Would Recommend
    
    30 Days
    
    Risk-Free Guarantee
    
    Each card
    
    White
    
    Rounded 20px
    
    Soft shadow
    
    --------------------------------------------------
    
    BUTTON
    
    Centered below the reviews.
    
    Text
    
    Read All Reviews
    
    Background
    
    #33452D
    
    Text
    
    White
    
    Hover
    
    #273522
    
    Rounded
    
    16px
    
    --------------------------------------------------
    
    TYPOGRAPHY
    
    Heading
    
    Cormorant Garamond
    
    56px
    
    Body
    
    Manrope
    
    18px
    
    Cards
    
    Manrope
    
    16px
    
    --------------------------------------------------
    
    ANIMATIONS
    
    Fade-up on scroll
    
    Carousel slides smoothly
    
    Cards stagger on load
    
    Hover lift
    
    6px
    
    Image zoom
    
    103%
    
    Transition
    
    300ms
    
    --------------------------------------------------
    
    THEME EDITOR SETTINGS
    
    Everything must be editable.
    
    Section Label
    
    Heading
    
    Description
    
    UGC Videos
    
    Video Thumbnail
    
    Video URL
    
    Customer Name
    
    Country
    
    Rating
    
    Review Text
    
    Product Purchased
    
    Statistics
    
    Button
    
    Spacing
    
    Colors
    
    Border Radius
    
    Carousel Speed
    
    --------------------------------------------------
    
    The final design should communicate authenticity, trust and premium quality.
    
    The section should feel luxurious, clean and modern, with generous whitespace, refined typography and elegant botanical styling consistent with the Folliq brand identity.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 60px;
  }

  .ai-reviews-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin-bottom: 16px;
  }

  .ai-reviews-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 400;
    color: {{ block.settings.heading_color }};
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .ai-reviews-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-reviews-video-carousel-{{ ai_gen_id }} {
    margin-bottom: 80px;
    overflow: hidden;
  }

  .ai-reviews-video-track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    transition: transform 0.5s ease;
  }

  .ai-reviews-video-card-{{ ai_gen_id }} {
    flex: 0 0 calc(25% - 15px);
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .ai-reviews-video-card-{{ ai_gen_id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-reviews-video-thumbnail-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
  }

  .ai-reviews-video-thumbnail-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-reviews-video-card-{{ ai_gen_id }}:hover .ai-reviews-video-thumbnail-{{ ai_gen_id }} img {
    transform: scale(1.03);
  }

  .ai-reviews-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .ai-reviews-video-card-{{ ai_gen_id }}:hover .ai-reviews-play-button-{{ ai_gen_id }} {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-reviews-play-icon-{{ ai_gen_id }} {
    width: 0;
    height: 0;
    border-left: 16px solid {{ block.settings.primary_green }};
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    margin-left: 4px;
  }

  .ai-reviews-video-info-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-reviews-video-customer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .ai-reviews-video-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-reviews-video-flag-{{ ai_gen_id }} {
    font-size: 16px;
  }

  .ai-reviews-video-rating-{{ ai_gen_id }} {
    color: #FFD700;
    font-size: 14px;
    margin-bottom: 4px;
  }

  .ai-reviews-video-duration-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 12px;
    color: #999;
  }

  .ai-reviews-summary-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-reviews-summary-rating-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ai-reviews-summary-stars-{{ ai_gen_id }} {
    color: #FFD700;
    font-size: 20px;
  }

  .ai-reviews-summary-score-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
  }

  .ai-reviews-summary-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    margin-bottom: 4px;
  }

  .ai-reviews-summary-subtext-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    color: #999;
  }

  .ai-reviews-stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 60px;
  }

  .ai-reviews-stat-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 20px;
    padding: 24px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .ai-reviews-stat-value-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, serif;
    font-size: 32px;
    font-weight: 600;
    color: {{ block.settings.primary_green }};
    margin-bottom: 8px;
  }

  .ai-reviews-stat-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    color: {{ block.settings.text_color }};
  }

  .ai-reviews-carousel-{{ ai_gen_id }} {
    margin-bottom: 60px;
    overflow: hidden;
  }

  .ai-reviews-track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    transition: transform 0.5s ease;
  }

  .ai-reviews-card-{{ ai_gen_id }} {
    flex: 0 0 calc(33.333% - 16px);
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-reviews-card-{{ ai_gen_id }}:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .ai-reviews-card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ai-reviews-customer-photo-{{ ai_gen_id }} {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ai-reviews-customer-photo-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-reviews-customer-info-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-reviews-customer-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 4px;
  }

  .ai-reviews-verified-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 12px;
    color: {{ block.settings.accent_green }};
  }

  .ai-reviews-card-rating-{{ ai_gen_id }} {
    color: #FFD700;
    font-size: 16px;
    margin-bottom: 16px;
  }

  .ai-reviews-card-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .ai-reviews-card-footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ai-reviews-product-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 13px;
    color: #999;
  }

  .ai-reviews-usage-badge-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 11px;
    color: {{ block.settings.accent_green }};
    background: rgba(86, 105, 75, 0.1);
    padding: 4px 12px;
    border-radius: 12px;
  }

  .ai-reviews-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-reviews-button-{{ ai_gen_id }} {
    display: inline-block;
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.button_text_color }};
    background: {{ block.settings.button_background }};
    padding: 16px 48px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .ai-reviews-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-reviews-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .ai-reviews-nav-button-{{ ai_gen_id }} {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid {{ block.settings.border_color }};
    background: {{ block.settings.card_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-reviews-nav-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.primary_green }};
    border-color: {{ block.settings.primary_green }};
  }

  .ai-reviews-nav-button-{{ ai_gen_id }}:hover svg {
    stroke: white;
  }

  .ai-reviews-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.text_color }};
    transition: stroke 0.3s ease;
  }

  @media screen and (max-width: 989px) {
    .ai-reviews-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-reviews-video-card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 10px);
    }

    .ai-reviews-card-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 12px);
    }

    .ai-reviews-stats-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 0 {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-reviews-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-reviews-video-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-reviews-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-reviews-stats-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-reviews-stat-value-{{ ai_gen_id }} {
      font-size: 24px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    <div class="ai-reviews-header-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-reviews-label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-reviews-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-reviews-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    {% if block.settings.show_video_carousel %}
      <div class="ai-reviews-video-carousel-{{ ai_gen_id }}">
        <div class="ai-reviews-video-track-{{ ai_gen_id }}" data-video-track>
          {% for i in (1..4) %}
            {% liquid
              assign video_enabled_key = 'video_' | append: i | append: '_enabled'
              assign video_thumbnail_key = 'video_' | append: i | append: '_thumbnail'
              assign video_url_key = 'video_' | append: i | append: '_url'
              assign video_name_key = 'video_' | append: i | append: '_customer_name'
              assign video_country_key = 'video_' | append: i | append: '_country'
              assign video_duration_key = 'video_' | append: i | append: '_duration'

              assign video_enabled = block.settings[video_enabled_key]
              assign video_thumbnail = block.settings[video_thumbnail_key]
              assign video_url = block.settings[video_url_key]
              assign video_name = block.settings[video_name_key]
              assign video_country = block.settings[video_country_key]
              assign video_duration = block.settings[video_duration_key]
            %}

            {% if video_enabled %}
              <div class="ai-reviews-video-card-{{ ai_gen_id }}" data-video-url="{{ video_url }}">
                <div class="ai-reviews-video-thumbnail-{{ ai_gen_id }}">
                  {% if video_thumbnail %}
                    <img src="{{ video_thumbnail | image_url: width: 400 }}" alt="{{ video_name }}" loading="lazy" width="400" height="711">
                  {% else %}
                    <div style="width: 100%; height: 100%; background: #f4f4f4; display: flex; align-items: center; justify-content: center;">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                  <div class="ai-reviews-play-button-{{ ai_gen_id }}">
                    <div class="ai-reviews-play-icon-{{ ai_gen_id }}"></div>
                  </div>
                </div>
                <div class="ai-reviews-video-info-{{ ai_gen_id }}">
                  <div class="ai-reviews-video-customer-{{ ai_gen_id }}">
                    <div class="ai-reviews-video-name-{{ ai_gen_id }}">{{ video_name }}</div>
                    <div class="ai-reviews-video-flag-{{ ai_gen_id }}">{{ video_country }}</div>
                  </div>
                  <div class="ai-reviews-video-rating-{{ ai_gen_id }}">★★★★★</div>
                  {% if video_duration != blank %}
                    <div class="ai-reviews-video-duration-{{ ai_gen_id }}">{{ video_duration }}</div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="ai-reviews-nav-{{ ai_gen_id }}">
          <button class="ai-reviews-nav-button-{{ ai_gen_id }}" data-video-prev aria-label="Previous videos">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="ai-reviews-nav-button-{{ ai_gen_id }}" data-video-next aria-label="Next videos">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_summary %}
      <div class="ai-reviews-summary-{{ ai_gen_id }}">
        <div class="ai-reviews-summary-rating-{{ ai_gen_id }}">
          <div class="ai-reviews-summary-stars-{{ ai_gen_id }}">★★★★★</div>
          <div class="ai-reviews-summary-score-{{ ai_gen_id }}">{{ block.settings.summary_rating }}</div>
        </div>
        <div class="ai-reviews-summary-text-{{ ai_gen_id }}">{{ block.settings.summary_text }}</div>
        <div class="ai-reviews-summary-subtext-{{ ai_gen_id }}">{{ block.settings.summary_subtext }}</div>
      </div>
    {% endif %}

    {% if block.settings.show_stats %}
      <div class="ai-reviews-stats-{{ ai_gen_id }}">
        <div class="ai-reviews-stat-card-{{ ai_gen_id }}">
          <div class="ai-reviews-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_1_value }}</div>
          <div class="ai-reviews-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
        </div>
        <div class="ai-reviews-stat-card-{{ ai_gen_id }}">
          <div class="ai-reviews-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_2_value }}</div>
          <div class="ai-reviews-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
        </div>
        <div class="ai-reviews-stat-card-{{ ai_gen_id }}">
          <div class="ai-reviews-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_3_value }}</div>
          <div class="ai-reviews-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
        </div>
        <div class="ai-reviews-stat-card-{{ ai_gen_id }}">
          <div class="ai-reviews-stat-value-{{ ai_gen_id }}">{{ block.settings.stat_4_value }}</div>
          <div class="ai-reviews-stat-label-{{ ai_gen_id }}">{{ block.settings.stat_4_label }}</div>
        </div>
      </div>
    {% endif %}

    <div class="ai-reviews-carousel-{{ ai_gen_id }}">
      <div class="ai-reviews-track-{{ ai_gen_id }}" data-review-track>
        {% for i in (1..6) %}
          {% liquid
            assign review_enabled_key = 'review_' | append: i | append: '_enabled'
            assign review_photo_key = 'review_' | append: i | append: '_photo'
            assign review_name_key = 'review_' | append: i | append: '_name'
            assign review_text_key = 'review_' | append: i | append: '_text'
            assign review_product_key = 'review_' | append: i | append: '_product'
            assign review_country_key = 'review_' | append: i | append: '_country'
            assign review_usage_key = 'review_' | append: i | append: '_usage'

            assign review_enabled = block.settings[review_enabled_key]
            assign review_photo = block.settings[review_photo_key]
            assign review_name = block.settings[review_name_key]
            assign review_text = block.settings[review_text_key]
            assign review_product = block.settings[review_product_key]
            assign review_country = block.settings[review_country_key]
            assign review_usage = block.settings[review_usage_key]
          %}

          {% if review_enabled %}
            <div class="ai-reviews-card-{{ ai_gen_id }}">
              <div class="ai-reviews-card-header-{{ ai_gen_id }}">
                <div class="ai-reviews-customer-photo-{{ ai_gen_id }}">
                  {% if review_photo %}
                    <img src="{{ review_photo | image_url: width: 112 }}" alt="{{ review_name }}" loading="lazy" width="112" height="112">
                  {% else %}
                    <div style="width: 100%; height: 100%; background: #f4f4f4; display: flex; align-items: center; justify-content: center;">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-reviews-customer-info-{{ ai_gen_id }}">
                  <div class="ai-reviews-customer-name-{{ ai_gen_id }}">{{ review_name }}</div>
                  <div class="ai-reviews-verified-badge-{{ ai_gen_id }}">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    Verified Buyer
                  </div>
                </div>
              </div>
              <div class="ai-reviews-card-rating-{{ ai_gen_id }}">★★★★★</div>
              {% if review_text != blank %}
                <div class="ai-reviews-card-text-{{ ai_gen_id }}">{{ review_text }}</div>
              {% endif %}
              <div class="ai-reviews-card-footer-{{ ai_gen_id }}">
                {% if review_product != blank %}
                  <div class="ai-reviews-product-{{ ai_gen_id }}">{{ review_product }} {{ review_country }}</div>
                {% endif %}
                {% if review_usage != blank %}
                  <div class="ai-reviews-usage-badge-{{ ai_gen_id }}">{{ review_usage }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="ai-reviews-nav-{{ ai_gen_id }}">
        <button class="ai-reviews-nav-button-{{ ai_gen_id }}" data-review-prev aria-label="Previous reviews">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="ai-reviews-nav-button-{{ ai_gen_id }}" data-review-next aria-label="Next reviews">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    {% if block.settings.button_text != blank %}
      <div class="ai-reviews-button-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_url }}" class="ai-reviews-button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.videoCurrentIndex = 0;
        this.reviewCurrentIndex = 0;
      }

      connectedCallback() {
        this.videoTrack = this.querySelector('[data-video-track]');
        this.reviewTrack = this.querySelector('[data-review-track]');
        this.videoPrevBtn = this.querySelector('[data-video-prev]');
        this.videoNextBtn = this.querySelector('[data-video-next]');
        this.reviewPrevBtn = this.querySelector('[data-review-prev]');
        this.reviewNextBtn = this.querySelector('[data-review-next]');

        this.setupCarousels();
        this.setupVideoLinks();
      }

      setupCarousels() {
        if (this.videoPrevBtn && this.videoNextBtn && this.videoTrack) {
          this.videoPrevBtn.addEventListener('click', () => this.slideVideo(-1));
          this.videoNextBtn.addEventListener('click', () => this.slideVideo(1));
        }

        if (this.reviewPrevBtn && this.reviewNextBtn && this.reviewTrack) {
          this.reviewPrevBtn.addEventListener('click', () => this.slideReview(-1));
          this.reviewNextBtn.addEventListener('click', () => this.slideReview(1));
        }
      }

      slideVideo(direction) {
        const cards = this.videoTrack.children;
        const totalCards = cards.length;
        const cardsPerView = this.getCardsPerView();
        const maxIndex = Math.max(0, totalCards - cardsPerView);

        this.videoCurrentIndex = Math.max(0, Math.min(maxIndex, this.videoCurrentIndex + direction));
        const cardWidth = cards[0].offsetWidth;
        const gap = 20;
        const offset = this.videoCurrentIndex * (cardWidth + gap);
        this.videoTrack.style.transform = `translateX(-${offset}px)`;
      }

      slideReview(direction) {
        const cards = this.reviewTrack.children;
        const totalCards = cards.length;
        const cardsPerView = this.getCardsPerView();
        const maxIndex = Math.max(0, totalCards - cardsPerView);

        this.reviewCurrentIndex = Math.max(0, Math.min(maxIndex, this.reviewCurrentIndex + direction));
        const cardWidth = cards[0].offsetWidth;
        const gap = 24;
        const offset = this.reviewCurrentIndex * (cardWidth + gap);
        this.reviewTrack.style.transform = `translateX(-${offset}px)`;
      }

      getCardsPerView() {
        if (window.innerWidth < 750) return 1;
        if (window.innerWidth < 990) return 2;
        return window.innerWidth < 1200 ? 3 : 4;
      }

      setupVideoLinks() {
        const videoCards = this.querySelectorAll('.ai-reviews-video-card-{{ ai_gen_id }}');
        videoCards.forEach(card => {
          card.addEventListener('click', () => {
            const videoUrl = card.dataset.videoUrl;
            if (videoUrl) {
              window.open(videoUrl, '_blank');
            }
          });
        });
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

