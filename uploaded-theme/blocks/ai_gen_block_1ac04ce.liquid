{% doc %}
  @prompt
    Create a premium "Common Hair Problems" section for the Folliq hair care brand.
    
    IMPORTANT:
    Follow the official Folliq Brand Guidelines exactly.
    
    Brand Style:
    
    • Premium
    • Luxury
    • Botanical
    • Minimal
    • Scandinavian
    • Clinical
    • Elegant
    
    Inspired by:
    
    Apple
    Aesop
    Vegamour
    Act+Acre
    Rhode
    
    Use ONLY the official Folliq brand colors.
    
    --------------------------------------------------
    
    COLOR PALETTE
    
    Primary Green
    #33452D
    
    Dark Green
    #273522
    
    Accent Green
    #56694B
    
    Warm Ivory
    #F2EEE3
    
    Soft Ivory
    #FAF8F3
    
    Text
    #1F231D
    
    Border
    #D9D8D2
    
    --------------------------------------------------
    
    SECTION BACKGROUND
    
    Background
    
    #FAF8F3
    
    Maximum Width
    
    1480px
    
    Padding
    
    120px Top
    
    120px Bottom
    
    --------------------------------------------------
    
    SECTION HEADER
    
    Small Label
    
    COMMON HAIR CONCERNS
    
    Heading
    
    Hair Problems That Won't Go Away?
    
    Description
    
    Stress, buildup, harsh products and everyday environmental factors can leave your hair looking weaker, thinner and less healthy over time.
    
    Centered.
    
    --------------------------------------------------
    
    LAYOUT
    
    Display four premium cards in one row.
    
    Desktop
    
    4 Columns
    
    Tablet
    
    2 Columns
    
    Mobile
    
    1 Column
    
    Gap
    
    24px
    
    --------------------------------------------------
    
    CARD STYLE
    
    White Background
    
    Rounded Corners
    
    24px
    
    Soft Shadow
    
    Overflow Hidden
    
    Hover Lift
    
    Image Zoom 103%
    
    Transition
    
    300ms
    
    --------------------------------------------------
    
    CARD 1
    
    Image
    
    Person noticing excessive hair shedding while brushing.
    
    Title
    
    Hair Thinning
    
    Description
    
    Hair appears thinner and lacks the volume and density it once had.
    
    --------------------------------------------------
    
    CARD 2
    
    Image
    
    Person scratching their scalp.
    
    Title
    
    Dry & Itchy Scalp
    
    Description
    
    Dryness, irritation and buildup can make your scalp feel uncomfortable every day.
    
    --------------------------------------------------
    
    CARD 3
    
    Image
    
    Person looking at damaged hair ends in the mirror.
    
    Title
    
    Weak & Damaged Hair
    
    Description
    
    Frequent styling, heat and environmental stress can leave hair dry and fragile.
    
    --------------------------------------------------
    
    CARD 4
    
    Image
    
    Person frustrated after trying multiple hair products.
    
    Title
    
    Products That Don't Deliver
    
    Description
    
    Many products only mask the symptoms instead of supporting long-term hair health.
    
    --------------------------------------------------
    
    TYPOGRAPHY
    
    Heading
    
    Cormorant Garamond
    
    56px
    
    Card Titles
    
    Cormorant Garamond
    
    30px
    
    Descriptions
    
    Manrope
    
    17px
    
    --------------------------------------------------
    
    ANIMATIONS
    
    Fade-up on Scroll
    
    Cards appear one after another.
    
    Hover Lift
    
    6px
    
    Image Zoom
    
    103%
    
    Transition
    
    300ms ease
    
    --------------------------------------------------
    
    THEME EDITOR SETTINGS
    
    Everything must be editable.
    
    Section Label
    
    Heading
    
    Description
    
    Images
    
    Titles
    
    Descriptions
    
    Spacing
    
    Colors
    
    Border Radius
    
    Typography
    
    --------------------------------------------------
    
    The final section should feel premium, trustworthy and educational while clearly highlighting the everyday hair concerns that Folliq is designed to support.
    
    Maintain generous whitespace and a clean Scandinavian aesthetic consistent with the Folliq brand identity.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .folliq-hair-problems-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .folliq-hair-problems-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .folliq-hair-problems-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .folliq-hair-problems-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-size: {{ block.settings.label_size }}px;
    letter-spacing: {{ block.settings.label_spacing }}px;
    text-transform: uppercase;
    color: {{ block.settings.label_color }};
    margin: 0 0 {{ block.settings.label_margin }}px;
  }

  .folliq-hair-problems-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin }}px;
  }

  .folliq-hair-problems-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    color: {{ block.settings.description_color }};
    max-width: {{ block.settings.description_max_width }}px;
    margin: 0 auto;
  }

  .folliq-hair-problems-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .folliq-hair-problems-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.card_shadow }};
    transition: transform {{ block.settings.transition_duration }}ms ease, box-shadow {{ block.settings.transition_duration }}ms ease;
    opacity: 0;
    transform: translateY(30px);
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}.animate {
    animation: folliq-fade-up-{{ ai_gen_id }} 0.6s ease forwards;
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}:nth-child(1).animate {
    animation-delay: 0.1s;
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}:nth-child(2).animate {
    animation-delay: 0.2s;
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}:nth-child(3).animate {
    animation-delay: 0.3s;
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}:nth-child(4).animate {
    animation-delay: 0.4s;
  }

  @keyframes folliq-fade-up-{{ ai_gen_id }} {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: {{ block.settings.card_hover_shadow }};
  }

  .folliq-hair-problems-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .folliq-hair-problems-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform {{ block.settings.transition_duration }}ms ease;
  }

  .folliq-hair-problems-card-{{ ai_gen_id }}:hover .folliq-hair-problems-card-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_zoom | divided_by: 100.0 }});
  }

  .folliq-hair-problems-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_background }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .folliq-hair-problems-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .folliq-hair-problems-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .folliq-hair-problems-card-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.card_title_font.family }}, {{ block.settings.card_title_font.fallback_families }};
    font-weight: {{ block.settings.card_title_font.weight }};
    font-size: {{ block.settings.card_title_size }}px;
    line-height: {{ block.settings.card_title_line_height }};
    color: {{ block.settings.card_title_color }};
    margin: 0 0 {{ block.settings.card_title_margin }}px;
  }

  .folliq-hair-problems-card-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.card_text_font.family }}, {{ block.settings.card_text_font.fallback_families }};
    font-weight: {{ block.settings.card_text_font.weight }};
    font-size: {{ block.settings.card_text_size }}px;
    line-height: {{ block.settings.card_text_line_height }};
    color: {{ block.settings.card_text_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .folliq-hair-problems-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .folliq-hair-problems-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }

    .folliq-hair-problems-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .folliq-hair-problems-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 0 {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .folliq-hair-problems-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .folliq-hair-problems-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.6);
    }

    .folliq-hair-problems-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .folliq-hair-problems-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.75);
    }

    .folliq-hair-problems-card-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_text_size }}px * 0.9);
    }
  }
{% endstyle %}

<folliq-hair-problems-{{ ai_gen_id }} class="folliq-hair-problems-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="folliq-hair-problems-container-{{ ai_gen_id }}">
    <div class="folliq-hair-problems-header-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="folliq-hair-problems-label-{{ ai_gen_id }}">
          {{ block.settings.label }}
        </div>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="folliq-hair-problems-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="folliq-hair-problems-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="folliq-hair-problems-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_text_key = 'card_' | append: i | append: '_text'
          
          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_text = block.settings[card_text_key]
        %}

        <div class="folliq-hair-problems-card-{{ ai_gen_id }}" data-card="{{ i }}">
          <div class="folliq-hair-problems-card-image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="{{ card_image.width }}"
                height="{{ card_image.height }}"
                class="folliq-hair-problems-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="folliq-hair-problems-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="folliq-hair-problems-card-content-{{ ai_gen_id }}">
            {% if card_title != blank %}
              <h3 class="folliq-hair-problems-card-title-{{ ai_gen_id }}">
                {{ card_title }}
              </h3>
            {% endif %}

            {% if card_text != blank %}
              <p class="folliq-hair-problems-card-text-{{ ai_gen_id }}">
                {{ card_text }}
              </p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</folliq-hair-problems-{{ ai_gen_id }}>

<script>
  (function() {
    class FolliqHairProblems{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = this.querySelectorAll('.folliq-hair-problems-card-{{ ai_gen_id }}');
        this.hasAnimated = false;
      }

      connectedCallback() {
        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && !this.hasAnimated) {
                  this.animateCards();
                  this.hasAnimated = true;
                }
              });
            },
            {
              threshold: 0.2,
              rootMargin: '0px 0px -50px 0px'
            }
          );

          this.observer.observe(this);
        } else {
          this.animateCards();
        }
      }

      animateCards() {
        this.cards.forEach((card) => {
          card.classList.add('animate');
        });
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }
    }

    customElements.define('folliq-hair-problems-{{ ai_gen_id }}', FolliqHairProblems{{ ai_gen_id }});
  })();
</script>

