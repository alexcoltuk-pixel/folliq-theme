{{ 'component-folliq-sections.css' | asset_url | stylesheet_tag }}

<section class="folliq-section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="folliq-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="folliq-heading">{{ section.settings.heading }}</h2>
  {%- if section.settings.subheading != blank -%}
    <p class="folliq-subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="folliq-compare">
    <div class="folliq-compare-col folliq-compare-col--them">
      <h3 class="folliq-compare-col__title">{{ section.settings.them_title }}</h3>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="folliq-compare-row">
            {%- render 'icon-x-folliq' -%}
            <span>{{ block.settings.them_text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="folliq-compare-col folliq-compare-col--us">
      <h3 class="folliq-compare-col__title">{{ section.settings.us_title }}</h3>
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="folliq-compare-row">
            {%- render 'icon-check-folliq' -%}
            <span>{{ block.settings.us_text }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Folliq Comparison Table",
  "tag": "section",
  "class": "section-folliq-compare",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Folliq Works When Others Don't" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>See how Folliq compares to regular shampoos and generic hair treatments.</p>" },
    { "type": "text", "id": "them_title", "label": "Left column title", "default": "Regular Shampoo" },
    { "type": "text", "id": "us_title", "label": "Right column title", "default": "Folliq" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "them_text", "label": "Regular shampoo text", "default": "Strips natural oils and weakens strands" },
        { "type": "text", "id": "us_text", "label": "Folliq text", "default": "Gently cleanses while strengthening every strand" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Comparison Table",
      "blocks": [
        { "type": "row", "settings": { "them_text": "Strips natural oils and weakens strands", "us_text": "Gently cleanses while strengthening every strand" } },
        { "type": "row", "settings": { "them_text": "Doesn't address the root cause of thinning", "us_text": "Targets the root cause with rosemary and biotin" } },
        { "type": "row", "settings": { "them_text": "Harsh sulfates irritate the scalp", "us_text": "Sulfate-free, gentle for daily use" } },
        { "type": "row", "settings": { "them_text": "Plastic bottle, single use", "us_text": "Zero-waste bar, lasts 2x longer" } },
        { "type": "row", "settings": { "them_text": "Generic, one-size-fits-all formula", "us_text": "Botanical formula backed by natural science" } }
      ]
    }
  ]
}
{% endschema %}
