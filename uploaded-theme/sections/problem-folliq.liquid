{{ 'component-folliq-sections.css' | asset_url | stylesheet_tag }}

<section class="folliq-section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="folliq-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="folliq-heading">{{ section.settings.heading }}</h2>
  {%- if section.settings.subheading != blank -%}
    <p class="folliq-subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div class="folliq-problem-grid">
    {%- for block in section.blocks -%}
      <div class="folliq-problem-card" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}
          <img
            class="folliq-problem-card__img"
            src="{{ block.settings.image | image_url: width: 600 }}"
            alt="{{ block.settings.image.alt | escape }}"
            width="600"
            height="450"
            loading="lazy"
          >
        {%- endif -%}
        <h3 class="folliq-problem-card__title">{{ block.settings.title }}</h3>
        <p class="folliq-problem-card__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Folliq Problem Grid",
  "tag": "section",
  "class": "section-folliq-problem",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Struggle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hair Problems That Won't Go Away?" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Stress, harsh products, and buildup can slowly weaken hair at the root.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Excessive Shedding" },
        { "type": "text", "id": "text", "label": "Text", "default": "Losing more strands than usual in the shower or brush." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Problem Grid",
      "blocks": [
        { "type": "problem", "settings": { "title": "Excessive Shedding", "text": "Losing more strands than usual in the shower or brush." } },
        { "type": "problem", "settings": { "title": "Thinning Hair", "text": "Noticeably less volume and density over time." } },
        { "type": "problem", "settings": { "title": "Dry, Brittle Strands", "text": "Hair that snaps and breaks before it can grow long." } },
        { "type": "problem", "settings": { "title": "Ineffective Products", "text": "Shampoos loaded with sulfates that strip, not strengthen." } }
      ]
    }
  ]
}
{% endschema %}
