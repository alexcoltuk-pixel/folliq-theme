{{ 'component-folliq-pdp-final.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-folliq-pdp-extra.js' | asset_url }}" defer="defer"></script>

<div class="folliq-tp color-{{ section.settings.color_scheme }}">
  <p class="folliq-tp__badge">
    {%- for i in (1..5) -%}{%- render 'icon-star-folliq' -%}{%- endfor -%}
    {{ section.settings.rating_text }}
  </p>
  <h2 class="folliq-tp__heading">
    {{ section.settings.heading }}
    {%- if section.settings.heading_accent != blank -%}
      <em>{{ section.settings.heading_accent }}</em>
    {%- endif -%}
  </h2>

  {%- assign photo_blocks = section.blocks | where: 'type', 'photo' -%}
  {%- if photo_blocks.size > 0 -%}
    <div class="folliq-tp__strip">
      {%- for block in photo_blocks -%}
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 200 }}" alt="Customer photo" loading="lazy" {{ block.shopify_attributes }}>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- assign row_blocks = section.blocks | where: 'type', 'review_row' -%}
  {%- for block in row_blocks -%}
    <div class="folliq-tp__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
      {%- for i in (1..3) -%}
        {%- assign title_key = 'title_' | append: i -%}
        {%- assign text_key = 'text_' | append: i -%}
        {%- assign author_key = 'author_' | append: i -%}
        {%- assign title_val = block.settings[title_key] -%}
        {%- if title_val != blank -%}
          <div class="folliq-tp__review">
            <div class="folliq-tp__review-stars">{%- for s in (1..5) -%}{%- render 'icon-star-folliq' -%}{%- endfor -%}</div>
            <h3 class="folliq-tp__review-title">{{ title_val }}</h3>
            <p class="folliq-tp__review-text">{{ block.settings[text_key] }}</p>
            <p class="folliq-tp__review-author">{{ block.settings[author_key] }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endfor -%}

  {%- if row_blocks.size > 1 -%}
    <div class="folliq-tp__nav">
      <button type="button" class="folliq-tp__nav-btn" data-tp-prev aria-label="Previous reviews">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="folliq-tp__progress"><div class="folliq-tp__progress-fill"></div></div>
      <button type="button" class="folliq-tp__nav-btn" data-tp-next aria-label="Next reviews">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Folliq Trustpilot",
  "tag": "section",
  "class": "section-folliq-trustpilot",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Rated 4.9 / 5.0 'Excellent'" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Thousands" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Customer photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    },
    {
      "type": "review_row",
      "name": "Review row (3 reviews)",
      "settings": [
        { "type": "text", "id": "title_1", "label": "Review 1 title", "default": "Love it!" },
        { "type": "textarea", "id": "text_1", "label": "Review 1 text", "default": "My hair feels so much stronger already. Wish I'd tried this years ago." },
        { "type": "text", "id": "author_1", "label": "Review 1 author", "default": "Marcus T." },
        { "type": "text", "id": "title_2", "label": "Review 2 title", "default": "Actually amazing" },
        { "type": "textarea", "id": "text_2", "label": "Review 2 text", "default": "Nothing else worked. This soap cleared it up in weeks. Wish I found this years ago!" },
        { "type": "text", "id": "author_2", "label": "Review 2 author", "default": "Jordan T." },
        { "type": "text", "id": "title_3", "label": "Review 3 title", "default": "Saved my confidence" },
        { "type": "textarea", "id": "text_3", "label": "Review 3 text", "default": "After using it for 3 weeks I don't even think about it anymore!" },
        { "type": "text", "id": "author_3", "label": "Review 3 author", "default": "Sean M." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Trustpilot",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "review_row" }
      ]
    }
  ]
}
{% endschema %}
