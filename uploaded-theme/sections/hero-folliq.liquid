{% comment %}
  Folliq Hero Section — custom-built, replaces Section Store "ss-hero-pro-2".
  Brand: Forest Green / Cream / Charcoal, Cormorant Garamond + Manrope.
{% endcomment %}

{{ 'component-hero-folliq.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile
-%}

<section
  class="hero-folliq color-{{ section.settings.color_scheme }}"
  style="
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hero-folliq__media">
    {%- if img -%}
      <img
        class="hero-folliq__img hero-folliq__img--desktop"
        src="{{ img | image_url: width: 1800 }}"
        srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 1800 }} 1800w, {{ img | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ img.alt | escape | default: 'Folliq' }}"
        width="{{ img.width }}"
        height="{{ img.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    {%- if img_mobile -%}
      <img
        class="hero-folliq__img hero-folliq__img--mobile"
        src="{{ img_mobile | image_url: width: 900 }}"
        srcset="{{ img_mobile | image_url: width: 700 }} 700w, {{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1200 }} 1200w"
        sizes="100vw"
        alt="{{ img_mobile.alt | escape | default: 'Folliq' }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="hero-folliq__overlay"></div>
  </div>

  <div class="hero-folliq__content hero-folliq__content--{{ section.settings.content_align }}">
    <div class="hero-folliq__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'badge' -%}
            <p class="hero-folliq__badge" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>

          {%- when 'heading' -%}
            <h1 class="hero-folliq__heading" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h1>

          {%- when 'rating' -%}
            <div class="hero-folliq__rating" {{ block.shopify_attributes }}>
              <span class="hero-folliq__stars" aria-hidden="true">
                {%- for i in (1..5) -%}
                  {%- render 'icon-star-folliq' -%}
                {%- endfor -%}
              </span>
              <span class="hero-folliq__rating-text">{{ block.settings.text }}</span>
            </div>

          {%- when 'text' -%}
            <div class="hero-folliq__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'buttons' -%}
            <div class="hero-folliq__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  href="{{ block.settings.button_url_1 | default: '#' }}"
                  class="hero-folliq__btn hero-folliq__btn--primary"
                >
                  {{ block.settings.button_label_1 }}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  href="{{ block.settings.button_url_2 | default: '#' }}"
                  class="hero-folliq__btn hero-folliq__btn--secondary"
                >
                  {{ block.settings.button_label_2 }}
                </a>
              {%- endif -%}
            </div>

          {%- when 'features' -%}
            <ul class="hero-folliq__features" {{ block.shopify_attributes }}>
              {%- for i in (1..4) -%}
                {%- assign icon_key = 'feature_icon_' | append: i -%}
                {%- assign text_key = 'feature_text_' | append: i -%}
                {%- assign icon_val = block.settings[icon_key] -%}
                {%- assign text_val = block.settings[text_key] -%}
                {%- if text_val != blank -%}
                  <li class="hero-folliq__feature">
                    {%- render 'icon-hero-folliq', icon: icon_val -%}
                    <span>{{ text_val }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'stats' -%}
            <div class="hero-folliq__stats" {{ block.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign percent_key = 'stat_percent_' | append: i -%}
                {%- assign heading_key = 'stat_heading_' | append: i -%}
                {%- assign text_key = 'stat_text_' | append: i -%}
                {%- assign percent_val = block.settings[percent_key] -%}
                {%- assign heading_val = block.settings[heading_key] -%}
                {%- assign text_val = block.settings[text_key] -%}
                {%- if heading_val != blank -%}
                  <div class="hero-folliq__stat">
                    {%- if percent_val > 0 -%}
                      <span class="hero-folliq__stat-percent">{{ percent_val }}%</span>
                    {%- endif -%}
                    <span class="hero-folliq__stat-heading">{{ heading_val }}</span>
                    {%- if text_val != blank -%}
                      <span class="hero-folliq__stat-text">{{ text_val }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Folliq Hero",
  "tag": "section",
  "class": "section-hero-folliq",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "★ Premium Quality Guaranteed"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "heading",
          "label": "Heading",
          "default": "<h1>Botanical Care for Hair That Looks Fuller, Feels Stronger.</h1>"
        }
      ]
    },
    {
      "type": "rating",
      "name": "Rating line",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Rating text",
          "default": "4.9/5 based on 10,000+ reviews"
        }
      ]
    },
    {
      "type": "text",
      "name": "Supporting text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Rosemary, ginger and biotin — a shampoo bar formulated to strengthen hair from root to tip.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "label": "Primary button label",
          "default": "Shop Folliq"
        },
        {
          "type": "url",
          "id": "button_url_1",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "button_url_2",
          "label": "Secondary button link"
        }
      ]
    },
    {
      "type": "features",
      "name": "Feature icons row",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "feature_icon_1",
          "label": "Icon 1",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "truck", "label": "Truck" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "none", "label": "None" }
