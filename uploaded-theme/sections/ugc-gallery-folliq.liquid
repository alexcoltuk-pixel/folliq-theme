{{ 'component-folliq-sections.css' | asset_url | stylesheet_tag }}

<section class="folliq-section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="folliq-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="folliq-heading">{{ section.settings.heading }}</h2>

  <div class="folliq-ugc-grid">
    {%- for block in section.blocks -%}
      <div class="folliq-ugc-item" {{ block.shopify_attributes }}>
        {%- if block.settings.video -%}
          <video src="{{ block.settings.video }}" muted loop playsinline autoplay poster="{{ block.settings.poster | image_url: width: 400 }}"></video>
        {%- elsif block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="Folliq customer content" loading="lazy">
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Folliq UGC Gallery",
  "tag": "section",
  "class": "section-folliq-ugc",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Folliq in Real Life" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Video or image",
      "settings": [
        { "type": "text", "id": "video", "label": "Video URL (mp4)", "info": "Leave blank to use image instead" },
        { "type": "image_picker", "id": "poster", "label": "Video poster image" },
        { "type": "image_picker", "id": "image", "label": "Image (if no video)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq UGC Gallery",
      "blocks": [{ "type": "media" }, { "type": "media" }, { "type": "media" }, { "type": "media" }, { "type": "media" }]
    }
  ]
}
{% endschema %}
