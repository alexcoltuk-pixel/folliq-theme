{{ 'component-folliq-pdp-final.css' | asset_url | stylesheet_tag }}

<div class="folliq-guar2 color-{{ section.settings.color_scheme }}">
  <div class="folliq-guar2__content">
    <span class="folliq-guar2__badge">{%- render 'icon-stats-folliq', icon: 'shield' -%}</span>
    <h2 class="folliq-guar2__heading">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank -%}
        <em>{{ section.settings.heading_accent }}</em>
      {%- endif -%}
    </h2>
    <p class="folliq-guar2__text">{{ section.settings.text }}</p>
  </div>
  {%- if section.settings.image -%}
    <div class="folliq-guar2__img-wrap">
      <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Folliq Guarantee Banner 2",
  "tag": "section",
  "class": "section-folliq-guarantee-2",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "30 Day Money-Back" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Guarantee" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Try Folliq risk-free. If you're not satisfied within 30 days, we'll refund your purchase, no questions asked.</p>" },
    { "type": "image_picker", "id": "image", "label": "Side image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Folliq Guarantee Banner 2" }]
}
{% endschema %}
