{{ 'component-folliq-sections.css' | asset_url | stylesheet_tag }}

<section class="folliq-section color-{{ section.settings.color_scheme }}">
  <div class="folliq-why">
    <div>
      {%- if section.settings.image -%}
        <img
          class="folliq-why__img"
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="folliq-eyebrow" style="text-align:left;">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="folliq-heading" style="text-align:left; margin-bottom: 2.4rem;">{{ section.settings.heading }}</h2>
      <ul class="folliq-why__list">
        {%- for block in section.blocks -%}
          <li class="folliq-why__item" {{ block.shopify_attributes }}>
            <span class="folliq-why__check">{%- render 'icon-check-folliq' -%}</span>
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Folliq Why Choose",
  "tag": "section",
  "class": "section-folliq-why",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Folliq" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Smarter Way to Care for Your Hair" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Targets the root cause of weak, thinning hair" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Why Choose",
      "blocks": [
        { "type": "item", "settings": { "text": "Targets the root cause of weak, thinning hair" } },
        { "type": "item", "settings": { "text": "Rosemary, ginger & biotin — botanical, not synthetic" } },
        { "type": "item", "settings": { "text": "Strengthens strands with every wash" } },
        { "type": "item", "settings": { "text": "Sulfate-free, gentle for daily use" } }
      ]
    }
  ]
}
{% endschema %}
