{{ 'component-folliq-pdp-final.css' | asset_url | stylesheet_tag }}

<div class="folliq-story color-{{ section.settings.color_scheme }}">
  <div class="folliq-story__grid">
    <div>
      {%- if section.settings.image -%}
        <img class="folliq-story__img" src="{{ section.settings.image | image_url: width: 700 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <h2 class="folliq-story__heading">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <em>{{ section.settings.heading_accent }}</em>
        {%- endif -%}
      </h2>
      <div class="folliq-story__text">{{ section.settings.text }}</div>

      <div class="folliq-story__grid-badges">
        {%- for block in section.blocks -%}
          <div class="folliq-story__badge" {{ block.shopify_attributes }}>
            {%- render 'icon-stats-folliq', icon: block.settings.icon -%}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Folliq Brand Story",
  "tag": "section",
  "class": "section-folliq-brand-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "5 Years. One Obsession." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "One Solution." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>For years, we've watched people cycle through shampoo after shampoo, only to see the same thinning and shedding return.</p><p>So we dedicated years to studying one thing: hair follicle health. What we discovered shaped Folliq.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "microscope", "label": "Microscope" },
            { "value": "target", "label": "Target" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "handshake", "label": "Handshake" }
          ],
          "default": "microscope"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Scientifically Formulated" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Brand Story",
      "blocks": [
        { "type": "badge", "settings": { "icon": "microscope", "text": "Scientifically Formulated" } },
        { "type": "badge", "settings": { "icon": "target", "text": "Targets the Root Cause" } },
        { "type": "badge", "settings": { "icon": "droplet", "text": "Simple Daily Routine" } },
        { "type": "badge", "settings": { "icon": "handshake", "text": "Trusted by Thousands" } }
      ]
    }
  ]
}
{% endschema %}
