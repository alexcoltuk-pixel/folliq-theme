{{ 'component-folliq-pdp-extra.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-folliq-pdp-extra.js' | asset_url }}" defer="defer"></script>

<div class="folliq-ing color-{{ section.settings.color_scheme }}">
  <div class="folliq-ing__grid">
    <div>
      {%- if section.settings.hero_image -%}
        <img class="folliq-ing__hero-img" src="{{ section.settings.hero_image | image_url: width: 700 }}" alt="{{ section.settings.hero_image.alt | escape }}" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <h2 class="folliq-ing__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="folliq-ing__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="folliq-ing__list">
        {%- for block in section.blocks -%}
          <button type="button" class="folliq-ing__list-item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.icon -%}
              <img class="folliq-ing__list-thumb" src="{{ block.settings.icon | image_url: width: 88 }}" alt="{{ block.settings.name | escape }}">
            {%- endif -%}
            <span>{{ block.settings.name }}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        <div class="folliq-ing__card{% if forloop.first %} is-active{% endif %}">
          {%- if block.settings.image -%}
            <img class="folliq-ing__card-img" src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
          {%- endif -%}
          <div class="folliq-ing__card-body">
            <h3 class="folliq-ing__card-title">{{ block.settings.name }}</h3>
            <p class="folliq-ing__card-text">{{ block.settings.description }}</p>
          </div>
        </div>
      {%- endfor -%}

      <div class="folliq-ing__nav">
        <button type="button" class="folliq-ing__nav-btn" data-ing-prev aria-label="Previous ingredient">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="folliq-ing__progress"><div class="folliq-ing__progress-fill"></div></div>
        <button type="button" class="folliq-ing__nav-btn" data-ing-next aria-label="Next ingredient">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Folliq Ingredients",
  "tag": "section",
  "class": "section-folliq-ingredients",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero product image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Powered by Nature's Most Effective Ingredients" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Select an ingredient to explore the science behind Folliq.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Thumbnail icon" },
        { "type": "image_picker", "id": "image", "label": "Card image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Rosemary Extract" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "A botanical extract known for stimulating circulation to the scalp. Helps support thicker, stronger-looking hair." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Rosemary Extract", "description": "A botanical extract known for stimulating circulation to the scalp. Helps support thicker, stronger-looking hair." } },
        { "type": "ingredient", "settings": { "name": "Ginger Root Extract", "description": "A warming natural extract that helps invigorate the scalp and support a healthy growth environment." } },
        { "type": "ingredient", "settings": { "name": "Biotin", "description": "A key B-vitamin known for supporting keratin production, the protein that makes up hair strands." } },
        { "type": "ingredient", "settings": { "name": "Coconut Oil", "description": "A nourishing natural oil that helps moisturize strands and reduce breakage from root to tip." } },
        { "type": "ingredient", "settings": { "name": "Shea Butter", "description": "A rich, plant-based butter that helps soften and protect hair against daily damage." } }
      ]
    }
  ]
}
{% endschema %}
