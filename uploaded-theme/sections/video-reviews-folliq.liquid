{{ 'component-folliq-pdp-final.css' | asset_url | stylesheet_tag }}

<div class="folliq-vidrev color-{{ section.settings.color_scheme }}">
  <h2 class="folliq-vidrev__heading">{{ section.settings.heading }}</h2>

  {%- assign video_blocks = section.blocks | where: 'type', 'video' -%}
  {%- assign visible_videos = 0 -%}
  {%- for block in video_blocks -%}
    {%- if block.settings.poster != blank and block.settings.video_url != blank -%}
      {%- assign visible_videos = visible_videos | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if visible_videos > 0 -%}
    <div class="folliq-vidrev__row">
      {%- for block in video_blocks -%}
        {%- if block.settings.poster != blank and block.settings.video_url != blank -%}
          <a
            class="folliq-vidrev__card"
            href="{{ block.settings.video_url }}"
            target="_blank"
            rel="noopener"
            {{ block.shopify_attributes }}
          >
            <span class="folliq-vidrev__poster-wrap">
              <img class="folliq-vidrev__poster" src="{{ block.settings.poster | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              <span class="folliq-vidrev__play">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </span>
            {%- if block.settings.name != blank -%}
              <span class="folliq-vidrev__name">{{ block.settings.name }}</span>
            {%- endif -%}
            {%- if block.settings.usage != blank -%}
              <span class="folliq-vidrev__usage">{{ block.settings.usage }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Folliq Video Reviews",
  "tag": "section",
  "class": "section-folliq-vidrev",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video review",
      "settings": [
        { "type": "image_picker", "id": "poster", "label": "Poster image" },
        { "type": "url", "id": "video_url", "label": "Video link" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Emma S." },
        { "type": "text", "id": "usage", "label": "Usage duration", "default": "Used for 3 months" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Folliq Video Reviews",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
