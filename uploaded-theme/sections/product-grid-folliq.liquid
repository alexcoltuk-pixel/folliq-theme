{{ 'component-folliq-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = collections[section.settings.collection]
-%}

<section class="folliq-section color-{{ section.settings.color_scheme }}">
  {%- if section.settings.eyebrow != blank -%}
    <p class="folliq-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="folliq-heading">{{ section.settings.heading }}</h2>
  {%- if section.settings.subheading != blank -%}
    <p class="folliq-subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  {%- if collection != blank -%}
    <div class="folliq-product-grid">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <a href="{{ product.url }}" class="folliq-product-card">
          <div class="folliq-product-card__img-wrap">
            {%- if product.featured_image -%}
              <img
                class="folliq-product-card__img"
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="600"
                height="600"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          {%- if section.settings.show_rating -%}
            <p class="folliq-product-card__rating">{{ section.settings.rating_text }}</p>
          {%- endif -%}
          <h3 class="folliq-product-card__title">{{ product.title }}</h3>
          <p class="folliq-product-card__price">
            {{ product.price | money }}
            {%- if product.compare_at_price > product.price -%}
              <s>{{ product.compare_at_price | money }}</s>
            {%- endif -%}
          </p>
          <span class="folliq-product-card__btn">{{ section.settings.button_label }}</span>
        </a>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p style="text-align:center; font-family: var(--font-body-family);">
      Select a collection in the section settings to display products.
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Folliq Product Grid",
  "tag": "section",
  "class": "section-folliq-products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best Sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Folliq Solution" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Formulas designed to cleanse, strengthen, and protect from root to tip.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating line", "default": true },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "Rated 4.9 / 5.0" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add To Cart" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Folliq Product Grid" }]
}
{% endschema %}
