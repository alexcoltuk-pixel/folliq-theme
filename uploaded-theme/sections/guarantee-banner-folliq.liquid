{{ 'component-folliq-sections.css' | asset_url | stylesheet_tag }}

<section class="folliq-section color-{{ section.settings.color_scheme }}">
  <div class="folliq-guarantee">
    {%- if section.settings.icon -%}
      <img class="folliq-guarantee__icon" src="{{ section.settings.icon | image_url: width: 128 }}" alt="" loading="lazy">
    {%- endif -%}
    <h2 class="folliq-guarantee__title">{{ section.settings.heading }}</h2>
    <p class="folliq-guarantee__text">{{ section.settings.text }}</p>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_url | default: '#' }}" class="folliq-btn">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Folliq Guarantee Banner",
  "tag": "section",
  "class": "section-folliq-guarantee",
  "settings": [
    { "type": "image_picker", "id": "icon", "label": "Icon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "30-Day Money-Back Guarantee" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Try Folliq risk-free. If you're not satisfied within 30 days, we'll refund your purchase, no questions asked.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Folliq Risk Free" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "Folliq Guarantee Banner" }]
}
{% endschema %}
