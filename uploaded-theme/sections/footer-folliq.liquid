{% comment %}
  Folliq Footer — custom-built, replaces the stock Dawn footer section.
  Brand: Forest Green / Cream / Charcoal, Cormorant Garamond + Manrope.
{% endcomment %}
{% comment %}theme-check-disable UndefinedObject{% endcomment %}

{{ 'component-footer-folliq.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif
-%}

<footer class="footer-folliq color-{{ section.settings.color_scheme }} gradient">
  <div class="footer-folliq__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="footer-folliq__top">
        {%- for block in section.blocks -%}
          <div class="footer-folliq__block footer-folliq__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'brand' -%}
                {%- assign logo_img = block.settings.logo | default: settings.logo -%}
                {%- if logo_img != blank -%}
                  {%- assign logo_height = block.settings.logo_width | divided_by: logo_img.aspect_ratio -%}
                  <a href="{{ routes.root_url }}" class="footer-folliq__logo-link">
                    {{
                      logo_img
                      | image_url: width: 300
                      | image_tag: loading: 'lazy', width: block.settings.logo_width, height: logo_height
                    }}
                  </a>
                {%- else -%}
                  <a href="{{ routes.root_url }}" class="footer-folliq__logo-text">{{ shop.name }}</a>
                {%- endif -%}
                {%- if block.settings.tagline != blank -%}
                  <div class="footer-folliq__tagline rte">{{ block.settings.tagline }}</div>
                {%- endif -%}
                {%- if block.settings.show_social and has_social_icons -%}
                  {%- render 'social-icons', class: 'footer-folliq__social' -%}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-folliq__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer-folliq__menu-list list-unstyled">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="footer-folliq__menu-link link{% if link.active %} footer-folliq__menu-link--active{% endif %}"
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-folliq__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <div class="footer-folliq__newsletter-text rte">{{ block.settings.subtext }}</div>
                {%- endif -%}
                {%- form 'customer', id: 'ContactFooter', class: 'footer-folliq__newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="footer-folliq__newsletter-field-wrapper">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="footer-folliq__newsletter-input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <button
                      type="submit"
                      class="footer-folliq__newsletter-submit"
                      name="commit"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="footer-folliq__form-message" id="ContactFooter-error">
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                  {%- if form.posted_successfully? -%}
                    <small
                      class="footer-folliq__form-message footer-folliq__form-message--success"
                      id="ContactFooter-success"
                      tabindex="-1"
                    >
                      {{- 'newsletter.success' | t -}}
                    </small>
                  {%- endif -%}
                {%- endform -%}

            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer-folliq__bottom">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1
        or section.settings.enable_language_selector and localization.available_languages.size > 1
      -%}
        <div class="footer-folliq__localization isolate">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_payment_icons -%}
        <ul class="footer-folliq__payment list-payment" role="list">
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-payment__item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="footer-folliq__copyright">
        <small>&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
        {%- if section.settings.show_policy_links -%}
          <ul class="footer-folliq__policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Folliq Footer",
  "tag": "footer",
  "class": "section-footer-folliq",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country/region selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Defaults to the theme logo if left blank"
        },
        {
          "type": "range",
          "id": "logo_width",
          "label": "Logo width",
          "min": 60,
          "max": 260,
          "step": 5,
          "unit": "px",
          "default": 130
        },
        {
          "type": "richtext",
          "id": "tagline",
          "label": "Tagline",
          "default": "<p>Botanical haircare formulated with rosemary, ginger and biotin.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Join the Folliq community"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Text",
          "default": "<p>Hair care tips, offers and early access — straight to your inbox.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      { "type": "menu" },
      {
        "type": "menu",
        "settings": { "heading": "Support" }
      },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
