{%- comment -%} Accepts: icon (string) — leaf, shield, truck, sparkle, none {%- endcomment -%}
{%- case icon -%}
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M4 20c8 0 15-6 16-16-9 0-16 7-16 16z"/>
      <path d="M4 20c2-6 6-10 12-13"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M2 7h11v9H2z"/>
      <path d="M13 10h4l4 3v3h-8z"/>
      <circle cx="6.5" cy="18" r="1.6"/>
      <circle cx="16.5" cy="18" r="1.6"/>
    </svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" fill="currentColor">
      <path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z"/>
    </svg>
  {%- else -%}
{%- endcase -%}
